# WHITELIST. This folder is a live job search; only the engineering is public.
# Everything is ignored unless named below: resume content, personal filters, the vault,
# generated .docx, reports, state files and .env never reach git.
/*
!/.gitignore
!/README.md
!/build/
!/deploy/
!/docs/
!/.github/

/build/*
!/build/nas_agent.py
!/build/build_docs.py
!/build/weekly_sweep.py
!/build/job_sources.py
!/build/selftest.py
!/build/content_example.py
!/build/my_profile_example.py
!/build/test_nas_agent.py
!/build/watchdog.py
!/build/mail_alerts.py

/deploy/*
!/deploy/nas/
/deploy/nas/*
!/deploy/nas/compose.yaml
!/deploy/nas/Dockerfile
!/deploy/nas/update.sh

/docs/*
!/docs/architecture.drawio
!/docs/architecture.drawio.svg
!/docs/architecture.png
!/docs/telegram-alert.png
!/docs/telegram-status.png
